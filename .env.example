# Copie este arquivo para .env antes de subir o projeto:
#
#   cp .env.example .env              # macOS/Linux
#   Copy-Item .env.example .env       # Windows (PowerShell)
#
# O servidor valida estas variáveis no boot e recusa iniciar se faltar alguma.

# Banco de dados (SQLite em desenvolvimento).
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os JWT.
#
# Qualquer valor serve em desenvolvimento. Em produção o servidor exige ao menos
# 32 caracteres: com um segredo curto, um token forjado passa pelo
# authMiddleware. Gere um com `openssl rand -hex 32`.
JWT_SECRET="troque-este-valor-em-producao"

# Porta do servidor HTTP (opcional, padrão 3333).
PORT=3333
